# Copy this file to .env and fill it in. .env is git-ignored, so your key stays private.
#
# The code talks to any OpenAI-compatible API, so switching between a local model
# and a paid API is just a change in this file.

# --- Option A: Ollama (free, runs on your laptop) ---
# 1. Install Ollama from ollama.com
# 2. Pull a model, e.g.:  ollama pull qwen2.5:7b   (handles German well)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# --- Option B: OpenAI API (paid, better answers) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<a current small/cheap model name from the OpenAI docs>
