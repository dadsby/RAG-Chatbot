# Copy this file to .env and fill it in. .env is git-ignored, so your key stays private.
#
# The code talks to any OpenAI-compatible API, so switching between a local model
# and a paid API is just a change in this file.

# --- Option A: Ollama (free, runs on your laptop) ---
# 1. Install Ollama from ollama.com
# 2. Pull a model, e.g.:  ollama pull qwen2.5:7b   (handles German well)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# --- Option B: OpenAI API (paid, better answers) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<a current small/cheap model name from the OpenAI docs>

# --- Option C: Claude API (paid, prepaid credits in the Claude Console) ---
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=<a model name from the Claude models overview page>

# --- Optional: a separate (stronger) model that grades answers in eval/run_answers.py ---
# If not set, the judge uses the LLM_* model above.
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...
# JUDGE_MODEL=<a strong model name from your provider's docs>

# --- Optional: password for the web app (any user name works) ---
# Set this before other people can reach the app (same Wi-Fi with --host 0.0.0.0, or a tunnel).
# APP_PASSWORD=choose-something-long
